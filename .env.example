# MongoDB Atlas / Local Connection String
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/plynest_attendance?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/plynest_attendance

# Optional dedicated connection string for Hytek (defaults to auto-replacing database name to hytek_attendance)
# HYTEK_MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/hytek_attendance?retryWrites=true&w=majority

# Authentication Secret (HMAC-SHA256 for JWT session tokens)
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars

# System Configuration
DEFAULT_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_APP_NAME="Prinson Attendance Management System"
NEXT_PUBLIC_SHOWROOM_NAME="Prinson Plynest Showroom"
